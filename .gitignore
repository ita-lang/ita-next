# Build artifacts
build/
*.dill

# Dart tooling
.dart_tool/
compiler/.dart_tool/
.packages
# pubspec.lock é VERSIONADO: ita_next_compiler é uma aplicação (CLI itac),
# não uma library — lock commitado dá builds reproduzíveis no CI.

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Memória de trabalho dos subagentes-especialista (notas, não deliverable).
# Os agentes em si (.claude/agents/) SÃO versionados; a memória deles, não.
.claude/agent-memory/

# --- Backend Dart stable pinado (ver dart-sdk.pin) ---
# SDK stable baixado: reproduzivel via tools/pin-dart.sh -> NAO versionar (~200MB)
/.dart-sdk/
# (o vendor do pkg/kernel em third_party/ e' versionado quando materializado —
#  nao existe no pub.dev; so entra na fase de codegen)

# Config LOCAL do Claude Code (por máquina; o settings.json versionado é o do projeto).
.claude/settings.local.json

# O wrapper do itac AOT (gerado por tools/build-itac.sh junto com build/itac).
# Versioná-lo congelaria o caminho ABSOLUTO do SDK da máquina de quem rodou o
# script — e o próximo clone herdaria um ITA_DART_SDK que não existe ali.
/bin/itac
